pipeline {
agent any
stages {
stage('checkout') {
steps {
git branch: 'release', url:
'https://github.com/devopsbyraham/jenkins-java-project.git'
}
}
stage('build') {
steps {
sh 'mvn compile'
}
}
stage('test') {
steps {
sh 'mvn test'
}
}
stage('Artifact') {
steps {
sh 'mvn package'
}
}
stage('DePloy') {
  steps {
    deploy adapters: [
      tomcat9(
        credentialsId: 'tomcat',
        path: '',
        url: "http://98.130.53.31:8080/"
      )
    ],
    contextPath: 'netflix',
    war: 'target/*.war'
}
}
}
}
